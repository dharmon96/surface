{
  "name": "surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Show-control console for live-event graphics: bout sheet in, Resolume / disguise / Companion out.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli/surface.ts",
    "server": "node --import tsx server/index.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "app": "electron .",
    "app:dev": "SURFACE_DEV=1 electron .",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  },
  "main": "electron/main.cjs"
}
