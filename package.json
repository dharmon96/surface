{
  "name": "surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Surface — show-control console for live-event graphics (MantaGlow)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli/surface.ts",
    "server": "node --import tsx server/index.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck:ui": "tsc -p tsconfig.app.json --noEmit",
    "app": "electron .",
    "app:dev": "cross-env SURFACE_DEV=1 electron .",
    "build:server": "tsc -p tsconfig.server.json",
    "dist": "npm run build && npm run build:server && electron-builder",
    "dist:win": "npm run build && npm run build:server && electron-builder --win",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac",
    "release": "npm run build && npm run build:server && electron-builder --publish always"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "mp4box": "^2.4.1",
    "snappyjs": "^0.7.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/three": "^0.184.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "zustand": "^5.0.15",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mantaglow.surface",
    "productName": "Surface",
    "copyright": "© MantaGlow",
    "asar": false,
    "files": [
      "electron/**",
      "dist/**",
      "dist-server/**",
      "fixtures/2026-06-13-glendale.bout.json",
      "surface.config.example.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Surface-Setup-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Surface"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "Surface-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "Surface-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dharmon96",
        "repo": "surface",
        "releaseType": "release"
      }
    ]
  }
}
